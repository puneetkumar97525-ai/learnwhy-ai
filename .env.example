# LearnWhy AI — Environment Configuration Example
# Copy this file to .env and adjust values as needed. Never commit real credentials.

# Application
APP_NAME="LearnWhy AI"
APP_ENV="development"
APP_VERSION="1.0.0"

# Database
# Default non-Docker local SQLite database (with foreign key enforcement):
DATABASE_URL="sqlite:///./backend/learnwhy.db"
# PostgreSQL alternative (used with docker-compose or local Postgres):
# DATABASE_URL="postgresql+psycopg2://learnwhy:learnwhy_dev_password@localhost:5432/learnwhy_ai"

# Security & Authentication
# Replace with a strong random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="replace-with-strong-random-jwt-secret-key-for-local-dev-only"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Learning Engine Hyperparameters (Provisional, configurable)
MASTERY_ALPHA=0.20
DEFAULT_PRIOR_MASTERY=0.35
REC_WEIGHT_GAP=0.50
REC_WEIGHT_PREREQ=0.30
REC_WEIGHT_DIFFICULTY=0.20
RULE_ENGINE_VERSION="v1.0.0-rules"
MASTERY_MODEL_VERSION="v1.0.0-ema-alpha0.2"

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=30
API_RATE_LIMIT_PER_MINUTE=180

# Optional Server-Side LLM Tutor Adapter
# Leave empty to use deterministic, curated explanations (default, recommended for MVP).
LLM_PROVIDER="none"
LLM_API_KEY=""
LLM_MODEL_NAME=""
LLM_TIMEOUT_SECONDS=8
