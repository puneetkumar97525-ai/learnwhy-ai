# Local SQLite by default; PostgreSQL may be configured for deployment
DATABASE_URL=sqlite:///./backend/learnwhy.db

# Replace with a long, unique random secret before running
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-running

MASTERY_ALPHA=0.20
REC_WEIGHT_GAP=0.50
REC_WEIGHT_PREREQ=0.30
REC_WEIGHT_DIFFICULTY=0.20

# Deterministic curated tutor mode; no external API key required
LLM_PROVIDER=none
